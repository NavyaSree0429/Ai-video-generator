# AI Service Configuration
PORT=8000
HOST=0.0.0.0
ENVIRONMENT=development
INTERNAL_SECRET_KEY=internal_service_secret_key_here

# Free Cloud AI Providers
# Hugging Face Free Inference Token (Optional, free tier from huggingface.co/settings/tokens)
HUGGINGFACE_API_KEY=

# Google Gemini API Key (Free tier from aistudio.google.com)
GEMINI_API_KEY=

# Pollinations.ai (Free, no API key required)
POLLINATIONS_ENABLED=true

