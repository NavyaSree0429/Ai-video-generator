# Server Configuration
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Database (MongoDB Atlas Free M0 or local MongoDB)
# Example Atlas: mongodb+srv://<user>:<password>@cluster0.mongodb.net/ai_video_studio?retryWrites=true&w=majority
MONGO_URI=mongodb://127.0.0.1:27017/ai_video_studio

# JWT Secret for User Authentication
JWT_SECRET=your_jwt_super_secret_key_change_in_production
JWT_EXPIRE=7d

# Redis Queue Connection (BullMQ)
# Supports local redis or free cloud Redis (e.g., Upstash rediss://default:...@...upstash.io:6379)
REDIS_URL=redis://127.0.0.1:6379
USE_REDIS_QUEUE=false

# Media Storage Configuration (Cloudinary Free Tier)
# Get credentials at https://cloudinary.com (Free Tier gives 25 credits/month)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Internal Python AI Service URL
AI_SERVICE_URL=http://localhost:8000
AI_SERVICE_SECRET=internal_service_secret_key_here

# Meta Instagram Graph API (Creator Account Integration)
# Set to 'true' to simulate Instagram publishing without requiring live Meta App approval
INSTAGRAM_MOCK_MODE=true
META_APP_ID=your_meta_app_id
META_APP_SECRET=your_meta_app_secret
META_REDIRECT_URI=http://localhost:5000/api/v1/instagram/callback

# Encryption key for Instagram Access Tokens (AES-256 requires 32 hex chars / 32 bytes)
TOKEN_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef

